{
  "name": "@justlend/mcp-server-justlend",
  "version": "1.1.4",
  "description": "MCP server for JustLend on TRON. Covers JustLend V1 (supply/borrow/repay/withdraw, sTRX staking, energy rental and direct purchase, governance, mining) and V2/Moolah (isolated markets, ERC4626 vaults, liquidation), TRX<->WTRX wrap/unwrap, general TRON chain utilities, and AI-guided DeFi prompts.",
  "type": "module",
  "module": "src/index.ts",
  "main": "build/index.js",
  "bin": {
    "mcp-server-justlend": "./bin/cli.js"
  },
  "files": [
    "build/",
    "bin/",
    "README.md",
    "CHANGELOG.md",
    "mcp-api-list.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "tsx src/index.ts",
    "prebuild": "rm -rf build",
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start:http": "tsx src/server/http-server.ts",
    "dev:http": "tsx watch src/server/http-server.ts",
    "test": "vitest run",
    "gen:api-list": "tsx scripts/gen-mcp-api-list.ts > mcp-api-list.md",
    "gen:integrity": "npm run build --silent && tsx scripts/gen-integrity.ts > integrity.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@bankofai/agent-wallet": "2.3.0",
    "@modelcontextprotocol/sdk": "1.32.0",
    "cors": "2.8.6",
    "express": "4.22.3",
    "express-rate-limit": "8.6.2",
    "open": "11.0.0",
    "tronweb": "6.2.2",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.19.15",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "axios": "1.20.0",
    "fast-uri": "3.1.9",
    "ip-address": "10.7.4",
    "hono": "4.13.12",
    "postcss": "8.5.30",
    "qs": "6.16.1",
    "ws": "8.21.0",
    "form-data": "4.0.6",
    "vite": "8.3.4",
    "esbuild": "0.28.1",
    "@hono/node-server": "2.1.3",
    "nanoid": "3.3.18",
    "proxy-addr": "2.0.8",
    "follow-redirects": "1.16.2",
    "source-map-js": "1.2.2",
    "zod": "$zod",
    "body-parser@1.x": "1.20.9",
    "body-parser@2.x": "2.4.0"
  },
  "engines": {
    "node": "24.22.1"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tron",
    "justlend",
    "defi",
    "lending",
    "borrowing",
    "ai",
    "agent",
    "jtoken"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justlend/mcp-server-justlend.git"
  },
  "homepage": "https://github.com/justlend/mcp-server-justlend#readme",
  "bugs": {
    "url": "https://github.com/justlend/mcp-server-justlend/issues"
  },
  "license": "MIT"
}
